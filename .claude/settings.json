{
  "permissions": {
    "deny": [
      "Read(frontend/node_modules/**)",
      "Read(frontend/dist/**)",
      "Read(server-components/venvs/**)",
      "Read(.git/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "statusMessage": "Reading AGENT_GUIDELINES.md...",
            "command": "$r=(git rev-parse --show-toplevel 2>$null); if(-not $r){exit 0}; $a=''; if(Test-Path \"$r/AGENT_GUIDELINES.md\"){$a+=Get-Content \"$r/AGENT_GUIDELINES.md\" -Raw}; if(Test-Path \"$r/frontend/FRONTEND_AGENT_GUIDELINES.md\"){$a+=[System.Environment]::NewLine+[System.Environment]::NewLine+'--- frontend/FRONTEND_AGENT_GUIDELINES.md ---'+[System.Environment]::NewLine+(Get-Content \"$r/frontend/FRONTEND_AGENT_GUIDELINES.md\" -Raw)}; if($a){$o=@{hookSpecificOutput=@{hookEventName='SessionStart';additionalContext='AGENT_GUIDELINES.md:'+[System.Environment]::NewLine+$a}};$o|ConvertTo-Json -Depth 5}"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Syncing agent memories...",
            "timeout": 120,
            "command": "bash \"$(git rev-parse --show-toplevel)/tools/sync_agent_memory.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
